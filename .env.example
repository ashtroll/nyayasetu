# ── Copy this file to .env and fill in your values ───────────────────────────

# Tor Control
# Tor Browser ports: 9150 (SOCKS) and 9151 (Control)
# Standalone Tor daemon ports: 9050 (SOCKS) and 9051 (Control)
TOR_CONTROL_PORT=9151
TOR_SOCKS_PORT=9150
TOR_CONTROL_PASSWORD=       # leave blank if using CookieAuthentication

# MeiliSearch
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=           # set a key or leave blank for development

# Paths (default values work if you keep the repo layout)
RAW_HTML_DIR=./data/raw_html
PROCESSED_JSON_DIR=./data/processed_json
CHROMA_DB_DIR=./database/chroma
MEILI_DB_DIR=./database/meili
